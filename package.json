{
  "name": "smarthub",
  "version": "0.0.0",
  "private": true,
  "description": "Tile Depot Discount Center — Floor Design + AR visualizer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node build.js",
    "preview": "vite preview",
    "serve": "node server.js",
    "start": "vite",
    "functions:install": "npm --prefix functions install",
    "deploy:functions": "firebase deploy --only functions,firestore:rules",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "firebase": "^12.18.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
